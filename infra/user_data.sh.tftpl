#!/bin/bash
set -euxo pipefail

PUBLIC_IP="${public_ip}"
NEKO_DIR="/opt/neko-rooms"

apt-get update
apt-get install -y ca-certificates curl git docker.io

systemctl enable docker
systemctl start docker

usermod -aG docker ubuntu || true

# Install Docker Compose manually because docker-compose-plugin was not available from apt
mkdir -p /usr/local/lib/docker/cli-plugins

if [ ! -f /usr/local/lib/docker/cli-plugins/docker-compose ]; then
  curl -SL https://github.com/docker/compose/releases/download/v2.27.0/docker-compose-linux-x86_64 \
    -o /usr/local/lib/docker/cli-plugins/docker-compose

  chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
fi

mkdir -p "$NEKO_DIR"

cat > "$NEKO_DIR/docker-compose.yml" <<COMPOSE
version: "3.5"

networks:
  default:
    attachable: true
    name: "neko-rooms-net"

services:
  neko-rooms:
    image: "m1k1o/neko-rooms:latest"
    restart: "unless-stopped"

    environment:
      - "TZ=America/Los_Angeles"
      - "NEKO_ROOMS_MUX=true"
      - "NEKO_ROOMS_EPR=59100-59999"
      - "NEKO_ROOMS_NAT1TO1=$PUBLIC_IP"
      - "NEKO_ROOMS_INSTANCE_URL=http://$PUBLIC_IP:8080/"
      - "NEKO_ROOMS_INSTANCE_NETWORK=neko-rooms-net"
      - "NEKO_ROOMS_TRAEFIK_ENABLED=false"
      - "NEKO_ROOMS_PATH_PREFIX=/room/"
      - "NEKO_ROOMS_NEKO_IMAGES=ghcr.io/m1k1o/neko/firefox:latest"

    ports:
      - "8080:8080"

    volumes:
      - "/var/run/docker.sock:/var/run/docker.sock"
COMPOSE

# Pre-pull images so creating rooms is faster
docker pull m1k1o/neko-rooms:latest
docker pull ghcr.io/m1k1o/neko/firefox:latest

# Remove stale dynamic rooms on boot
docker ps -a --format "{{.Names}}" | grep "^neko-rooms-" | xargs -r docker rm -f || true

cat > /etc/systemd/system/neko-rooms.service <<SERVICE
[Unit]
Description=Neko Rooms
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=$NEKO_DIR
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable neko-rooms.service
systemctl start neko-rooms.service