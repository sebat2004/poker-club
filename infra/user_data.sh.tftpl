#!/usr/bin/env bash
set -euo pipefail

PUBLIC_IP="${public_ip}"
DATA_VOLUME_ID="${data_volume_id}"
DATA_VOLUME_ID_NO_DASH="${data_volume_id_no_dash}"

NEKO_ROOT="/opt/neko-rooms"
NEKO_DATA="/opt/neko-rooms/data"

NEKO_ROOMS_IMAGE="m1k1o/neko-rooms:latest"
NEKO_FIREFOX_IMAGE="sebat2004/neko-firefox-xprintidle:latest"

echo "[user-data] Starting Neko Rooms setup..."

export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y \
  ca-certificates \
  curl \
  gnupg \
  lsb-release \
  jq \
  unzip \
  cron \
  xfsprogs \
  rsync

echo "[user-data] Installing Docker..."

install -m 0755 -d /etc/apt/keyrings

if [ ! -f /etc/apt/keyrings/docker.gpg ]; then
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
    | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
fi

echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
  > /etc/apt/sources.list.d/docker.list

apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

systemctl enable docker
systemctl start docker

usermod -aG docker ubuntu || true

echo "[user-data] Creating base directories..."

mkdir -p "$NEKO_ROOT"
mkdir -p "$NEKO_ROOT/bin"
mkdir -p "$NEKO_DATA"

echo "[user-data] Waiting for EBS data volume..."

DATA_DEVICE=""

for i in $(seq 1 60); do
  if [ -e "/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${DATA_VOLUME_ID_NO_DASH}" ]; then
    DATA_DEVICE="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${DATA_VOLUME_ID_NO_DASH}"
    break
  fi

  if [ -e "/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${DATA_VOLUME_ID}" ]; then
    DATA_DEVICE="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${DATA_VOLUME_ID}"
    break
  fi

  DATA_DEVICE_CANDIDATE=$(lsblk -ndo NAME,TYPE | awk '$2 == "disk" {print "/dev/" $1}' | grep -v -E '^/dev/nvme0n1$' | head -n 1 || true)

  if [ -n "$$DATA_DEVICE_CANDIDATE" ] && [ -b "$$DATA_DEVICE_CANDIDATE" ]; then
    DATA_DEVICE="$$DATA_DEVICE_CANDIDATE"
    break
  fi

  echo "[user-data] Waiting for volume device... attempt $i"
  sleep 2
done

if [ -z "$${DATA_DEVICE:-}" ] || [ ! -e "$DATA_DEVICE" ]; then
  echo "[user-data] ERROR: Could not find EBS data volume device"
  lsblk
  exit 1
fi

echo "[user-data] Found data device: $DATA_DEVICE"

if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
  echo "[user-data] Formatting data volume..."
  mkfs.ext4 -F "$DATA_DEVICE"
fi

mkdir -p "$NEKO_DATA"

if ! grep -q "$NEKO_DATA" /etc/fstab; then
  DATA_UUID=$(blkid -s UUID -o value "$DATA_DEVICE")
  echo "UUID=$DATA_UUID $NEKO_DATA ext4 defaults,nofail 0 2" >> /etc/fstab
fi

mount -a

echo "[user-data] Ensuring storage directories exist on mounted volume..."

mkdir -p "$NEKO_DATA/public"
mkdir -p "$NEKO_DATA/public/firefox-profile"
mkdir -p "$NEKO_DATA/public/golden-firefox-profile"
mkdir -p "$NEKO_DATA/public/profile-clones"
mkdir -p "$NEKO_DATA/templates"
mkdir -p "$NEKO_DATA/templates/firefox-policy"

for n in 1 2 3 4 5; do
  mkdir -p "$NEKO_DATA/public/profile-clones/gto-profile-$n"
done

chown -R 1000:1000 "$NEKO_DATA/public" || true
chmod -R 755 "$NEKO_DATA" || true

echo "[user-data] Writing Firefox policy..."

cat > "$NEKO_DATA/templates/firefox-policy/policies.json" <<'EOF'
{
  "policies": {
    "Homepage": {
      "URL": "https://www.gtowizard.com",
      "StartPage": "homepage",
      "Locked": true
    },
    "SanitizeOnShutdown": {
      "Cache": true,
      "Cookies": false,
      "Downloads": true,
      "FormData": true,
      "History": false,
      "OfflineApps": true,
      "Sessions": false,
      "SiteSettings": false
    },
    "DisablePrivateBrowsing": true,
    "DisableDeveloperTools": true,
    "DisableFirefoxAccounts": true,
    "DisableFirefoxScreenshots": true,
    "DisableMasterPasswordCreation": true,
    "DisableProfileImport": true,
    "DisableSafeMode": true,
    "DisableSystemAddonUpdate": true,
    "BlockAboutConfig": true,
    "BlockAboutProfiles": true,
    "BlockAboutSupport": true,
    "NewTabPage": false,
    "WebsiteFilter": {
      "Block": ["*"],
      "Exceptions": [
        "https://www.gtowizard.com/*",
        "https://app.gtowizard.com/*",
        "https://accounts.google.com/*",
        "https://*.google.com/*",
        "https://*.gstatic.com/*",
        "https://*.googleusercontent.com/*",
        "https://*.googleapis.com/*"
      ]
    },
    "Preferences": {
      "browser.startup.page": {
        "Value": 1,
        "Status": "locked"
      },
      "browser.startup.homepage": {
        "Value": "https://www.gtowizard.com",
        "Status": "locked"
      },
      "browser.sessionstore.resume_from_crash": {
        "Value": false,
        "Status": "locked"
      },
      "browser.sessionstore.max_resumed_crashes": {
        "Value": 0,
        "Status": "locked"
      },
      "browser.tabs.warnOnClose": {
        "Value": false,
        "Status": "locked"
      },
      "browser.warnOnQuit": {
        "Value": false,
        "Status": "locked"
      },
      "browser.newtabpage.enabled": {
        "Value": false,
        "Status": "locked"
      }
    }
  }
}
EOF

echo "[user-data] Writing Firefox kiosk supervisord config..."

cat > "$NEKO_DATA/templates/firefox.conf" <<'EOF'
[program:firefox]
environment=HOME="/home/%(ENV_USER)s",USER="%(ENV_USER)s",DISPLAY="%(ENV_DISPLAY)s"
command=/usr/bin/firefox --no-remote -P default --display=%(ENV_DISPLAY)s -setDefaultBrowser -width 1280 -height 720 --kiosk https://www.gtowizard.com
stopsignal=INT
autorestart=true
priority=800
user=%(ENV_USER)s
stdout_logfile=/var/log/neko/firefox.log
stdout_logfile_maxbytes=100MB
stdout_logfile_backups=10
redirect_stderr=true

[program:openbox]
environment=HOME="/home/%(ENV_USER)s",USER="%(ENV_USER)s",DISPLAY="%(ENV_DISPLAY)s"
command=/usr/bin/openbox --config-file /etc/neko/openbox.xml
autorestart=true
priority=300
user=%(ENV_USER)s
stdout_logfile=/var/log/neko/openbox.log
stdout_logfile_maxbytes=100MB
stdout_logfile_backups=10
redirect_stderr=true
EOF

echo "[user-data] Writing profile clone script..."

cat > "$NEKO_ROOT/bin/clone-gto-profiles.sh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

SOURCE_PROFILE="$${1:-/opt/neko-rooms/data/public/firefox-profile}"
COUNT="$${2:-5}"
CLONES_DIR="/opt/neko-rooms/data/public/profile-clones"

if [ ! -d "$SOURCE_PROFILE" ]; then
  echo "Source profile does not exist: $SOURCE_PROFILE"
  exit 1
fi

mkdir -p "$CLONES_DIR"

for i in $(seq 1 "$COUNT"); do
  DEST="$CLONES_DIR/gto-profile-$i"

  echo "Creating clone: $DEST"

  rm -rf "$DEST"
  mkdir -p "$DEST"

  rsync -a --delete "$SOURCE_PROFILE/" "$DEST/"

  rm -f "$DEST/lock" || true
  rm -f "$DEST/.parentlock" || true
  rm -f "$DEST/parent.lock" || true
  rm -f "$DEST/sessionstore.jsonlz4" || true
  rm -rf "$DEST/sessionstore-backups" || true
  rm -rf "$DEST/startupCache" || true

  chown -R 1000:1000 "$DEST" || true
done

echo "Done cloning $COUNT profiles."
EOF

chmod +x "$NEKO_ROOT/bin/clone-gto-profiles.sh"

echo "[user-data] Writing idle cleanup script..."

cat > "$NEKO_ROOT/bin/cleanup-idle-rooms.sh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

IDLE_LIMIT_MS=$((3 * 60 * 1000))

echo "[$(date -Is)] Checking Neko room idle times..."

containers=$(docker ps \
  --filter "label=club=poker-club" \
  --filter "label=purpose=gto-wizard" \
  --format "{{.Names}}")

if [ -z "$containers" ]; then
  echo "[$(date -Is)] No poker club room containers found by label. Trying name fallback..."

  containers=$(docker ps \
    --format "{{.Names}}" \
    | grep -E "neko-rooms.*poker|poker-room|gto" || true)
fi

if [ -z "$containers" ]; then
  echo "[$(date -Is)] No poker club room containers found."
  exit 0
fi

for container in $containers; do
  echo "[$(date -Is)] Checking $container..."

  idle_ms=$(docker exec "$container" bash -lc 'DISPLAY="$${DISPLAY:-:0}" xprintidle' 2>/dev/null || echo "")

  if ! [[ "$idle_ms" =~ ^[0-9]+$ ]]; then
    echo "[$(date -Is)] Could not read idle time for $container. Skipping."
    continue
  fi

  echo "[$(date -Is)] $container idle for $${idle_ms}ms"

  if [ "$idle_ms" -gt "$IDLE_LIMIT_MS" ]; then
    echo "[$(date -Is)] Removing idle room container: $container"
    docker rm -f "$container"
  fi
done
EOF

chmod +x "$NEKO_ROOT/bin/cleanup-idle-rooms.sh"

echo "[user-data] Installing idle cleanup cron..."

cat > /etc/cron.d/neko-idle-cleanup <<'EOF'
* * * * * root /opt/neko-rooms/bin/cleanup-idle-rooms.sh >> /var/log/neko-idle-cleanup.log 2>&1
EOF

chmod 0644 /etc/cron.d/neko-idle-cleanup
systemctl enable cron
systemctl restart cron

echo "[user-data] Writing Neko Rooms env..."

cat > "$NEKO_ROOT/.env" <<EOF
PUBLIC_IP=$PUBLIC_IP
NEKO_ROOMS_PUBLIC_URL=http://$PUBLIC_IP:8080

NEKO_ROOMS_IMAGE=$NEKO_ROOMS_IMAGE
NEKO_FIREFOX_IMAGE=$NEKO_FIREFOX_IMAGE

NEKO_ROOMS_MOUNTS_WHITELIST=/opt/neko-rooms/data
NEKO_ROOMS_STORAGE_ENABLED=true
NEKO_ROOMS_STORAGE_EXTERNAL=/opt/neko-rooms/data
NEKO_ROOMS_STORAGE_INTERNAL=/data
EOF

echo "[user-data] Writing Docker Compose from tracked repo file..."

cat > "$NEKO_ROOT/docker-compose.yml" <<'EOF'
${docker_compose_yml}
EOF

echo "[user-data] Writing systemd service..."

cat > /etc/systemd/system/neko-rooms.service <<'EOF'
[Unit]
Description=Neko Rooms
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/neko-rooms
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable neko-rooms.service

echo "[user-data] Pulling Docker images..."

docker pull m1k1o/neko-rooms:latest || true
docker pull ghcr.io/m1k1o/neko/firefox:latest || true
docker pull sebat2004/neko-firefox-xprintidle:latest || true

echo "[user-data] Starting Neko Rooms..."

systemctl restart neko-rooms.service

echo "[user-data] Final status checks..."

findmnt /opt/neko-rooms/data || true
docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}" || true
systemctl status neko-rooms.service --no-pager || true
systemctl status cron --no-pager || true

echo "[user-data] Setup complete."