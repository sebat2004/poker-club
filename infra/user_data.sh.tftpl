#!/usr/bin/env bash
set -euxo pipefail

DOMAIN_NAME="neko.osupoker.club"
PUBLIC_IP="${public_ip}"
NEKO_PUBLIC_URL="https://neko.osupoker.club"

DATA_VOLUME_ID="${data_volume_id}"
DATA_VOLUME_ID_NO_DASH="${data_volume_id_no_dash}"

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y \
  ca-certificates \
  curl \
  gnupg \
  lsb-release \
  apt-transport-https \
  software-properties-common \
  cron \
  jq \
  util-linux \
  xfsprogs \
  rsync

# -----------------------------
# Persistent EBS data mount
# -----------------------------
mkdir -p /opt/neko-rooms
mkdir -p /opt/neko-rooms/data

DEVICE_BY_ID="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${data_volume_id_no_dash}"

echo "Waiting for EBS data volume: $DEVICE_BY_ID"

for i in $(seq 1 60); do
  if [ -e "$DEVICE_BY_ID" ]; then
    break
  fi

  echo "Waiting for data volume to appear... attempt $i"
  sleep 2
done

if [ ! -e "$DEVICE_BY_ID" ]; then
  echo "ERROR: Data volume did not appear at $DEVICE_BY_ID"
  ls -la /dev/disk/by-id || true
  lsblk || true
  exit 1
fi

if ! blkid "$DEVICE_BY_ID" >/dev/null 2>&1; then
  echo "No filesystem found on data volume. Creating ext4 filesystem."
  mkfs.ext4 -F "$DEVICE_BY_ID"
fi

if ! grep -q "$DEVICE_BY_ID" /etc/fstab; then
  echo "$DEVICE_BY_ID /opt/neko-rooms/data ext4 defaults,nofail 0 2" >> /etc/fstab
fi

mountpoint -q /opt/neko-rooms/data || mount /opt/neko-rooms/data

# -----------------------------
# Neko Rooms directories
# -----------------------------
mkdir -p /opt/neko-rooms
mkdir -p /opt/neko-rooms/bin
mkdir -p /opt/neko-rooms/data
mkdir -p /opt/neko-rooms/data/public
mkdir -p /opt/neko-rooms/data/templates
mkdir -p /opt/neko-rooms/data/templates/firefox-policy
mkdir -p /opt/neko-rooms/data/public/profile-clones
mkdir -p /opt/neko-rooms/data/caddy

# -----------------------------
# Docker install
# -----------------------------
if ! command -v docker >/dev/null 2>&1; then
  install -m 0755 -d /etc/apt/keyrings

  curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
    | gpg --dearmor -o /etc/apt/keyrings/docker.gpg

  chmod a+r /etc/apt/keyrings/docker.gpg

  echo \
    "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
    $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
    > /etc/apt/sources.list.d/docker.list

  apt-get update
  apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
fi

systemctl enable docker
systemctl start docker

# -----------------------------
# Caddy install for HTTPS/TLS + Basic Auth
# -----------------------------
if ! command -v caddy >/dev/null 2>&1; then
  apt-get install -y debian-keyring debian-archive-keyring apt-transport-https curl

  curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' \
    | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg

  curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' \
    | tee /etc/apt/sources.list.d/caddy-stable.list

  apt-get update
  apt-get install -y caddy
fi

# Persist Caddy certs/config on the Neko data volume so EC2 replacements
# do not burn Let’s Encrypt duplicate certificate limits.
mkdir -p /opt/neko-rooms/data/caddy/.local/share
mkdir -p /opt/neko-rooms/data/caddy/.config

if [ -d /var/lib/caddy ] && [ ! -d /opt/neko-rooms/data/caddy/.local/share/caddy ]; then
  rsync -a /var/lib/caddy/ /opt/neko-rooms/data/caddy/ || true
fi

chown -R caddy:caddy /opt/neko-rooms/data/caddy || true

mkdir -p /etc/systemd/system/caddy.service.d

cat >/etc/systemd/system/caddy.service.d/override.conf <<'EOF'
[Service]
Environment=XDG_DATA_HOME=/opt/neko-rooms/data/caddy/.local/share
Environment=XDG_CONFIG_HOME=/opt/neko-rooms/data/caddy/.config
EOF

systemctl daemon-reload

cat >/etc/caddy/Caddyfile <<'EOF'
neko.osupoker.club {
  # Let users open actual Neko room links without Caddy basic auth.
  handle /room/* {
    reverse_proxy localhost:8080
  }

  # Everything else, like the Neko Rooms dashboard and API, requires admin login.
  handle {
    basic_auth {
      admin ${caddy_basic_auth_hash}
    }

    reverse_proxy localhost:8080
  }
}
EOF

caddy validate --config /etc/caddy/Caddyfile
systemctl enable caddy
systemctl restart caddy

# -----------------------------
# Neko Rooms environment
# -----------------------------
cat >/opt/neko-rooms/.env <<EOF
PUBLIC_IP=$${PUBLIC_IP}
NEKO_ROOMS_PUBLIC_URL=$${NEKO_PUBLIC_URL}
EOF

# -----------------------------
# Neko Rooms Docker Compose
# -----------------------------
cat >/opt/neko-rooms/docker-compose.yml <<'EOF'
services:
  neko-rooms:
    image: m1k1o/neko-rooms:latest
    restart: unless-stopped
    ports:
      - "8080:8080"
    environment:
      TZ: America/Los_Angeles

      NEKO_ROOMS_MUX: "true"
      NEKO_ROOMS_EPR: 59000-59049
      NEKO_ROOMS_NAT1TO1: $${PUBLIC_IP}
      NEKO_ROOMS_INSTANCE_URL: $${NEKO_ROOMS_PUBLIC_URL}/
      NEKO_ROOMS_INSTANCE_NETWORK: neko-rooms_default
      NEKO_ROOMS_TRAEFIK_ENABLED: "false"
      NEKO_ROOMS_PATH_PREFIX: /room/

      NEKO_ROOMS_MOUNTS_WHITELIST: /opt/neko-rooms/data
      NEKO_ROOMS_STORAGE_ENABLED: "true"
      NEKO_ROOMS_STORAGE_EXTERNAL: /opt/neko-rooms/data
      NEKO_ROOMS_STORAGE_INTERNAL: /data

      NEKO_ROOMS_NEKO_IMAGES: "ghcr.io/m1k1o/neko/firefox:latest sebat2004/neko-firefox-xprintidle:latest"

    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /opt/neko-rooms/data:/data
      - /opt/neko-rooms/data:/opt/neko-rooms/data
EOF

# -----------------------------
# Firefox kiosk config
# -----------------------------
cat >/opt/neko-rooms/data/templates/firefox.conf <<'EOF'
[program:firefox]
environment=HOME="/home/%(ENV_USER)s",USER="%(ENV_USER)s",DISPLAY="%(ENV_DISPLAY)s"
command=/usr/bin/firefox --no-remote -P default --display=%(ENV_DISPLAY)s -setDefaultBrowser -width 1280 -height 720 --kiosk https://www.gtowizard.com
stopsignal=INT
autorestart=true
priority=800
user=%(ENV_USER)s
stdout_logfile=/var/log/neko/firefox.log
stdout_logfile_maxbytes=100MB
stdout_logfile_backups=10
redirect_stderr=true

[program:openbox]
environment=HOME="/home/%(ENV_USER)s",USER="%(ENV_USER)s",DISPLAY="%(ENV_DISPLAY)s"
command=/usr/bin/openbox --config-file /etc/neko/openbox.xml
autorestart=true
priority=300
user=%(ENV_USER)s
stdout_logfile=/var/log/neko/openbox.log
stdout_logfile_maxbytes=100MB
stdout_logfile_backups=10
redirect_stderr=true
EOF

# -----------------------------
# Firefox policy
# -----------------------------
cat >/opt/neko-rooms/data/templates/firefox-policy/policies.json <<'EOF'
{
  "policies": {
    "DisablePrivateBrowsing": true,
    "DisableDeveloperTools": true,
    "DisableFirefoxAccounts": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "DisableTelemetry": true,
    "OfferToSaveLogins": false,
    "PasswordManagerEnabled": false,

    "Homepage": {
      "URL": "https://www.gtowizard.com",
      "Locked": true,
      "StartPage": "homepage"
    },

    "Preferences": {
      "browser.startup.homepage": {
        "Value": "https://www.gtowizard.com",
        "Status": "locked"
      },
      "browser.urlbar.suggest.history": {
        "Value": false,
        "Status": "locked"
      },
      "browser.urlbar.suggest.bookmark": {
        "Value": false,
        "Status": "locked"
      },
      "browser.urlbar.suggest.openpage": {
        "Value": false,
        "Status": "locked"
      },
      "signon.rememberSignons": {
        "Value": false,
        "Status": "locked"
      }
    },

    "WebsiteFilter": {
      "Block": [
        "<all_urls>"
      ],
      "Exceptions": [
        "https://gtowizard.com/*",
        "https://www.gtowizard.com/*",
        "https://app.gtowizard.com/*",
        "https://*.gtowizard.com/*",

        "https://accounts.google.com/*",
        "https://oauth2.googleapis.com/*",
        "https://www.googleapis.com/*",
        "https://apis.google.com/*",
        "https://ssl.gstatic.com/*",
        "https://www.gstatic.com/*",
        "https://*.googleapis.com/*",
        "https://*.gstatic.com/*"
      ]
    }
  }
}
EOF

# -----------------------------
# Profile clone script
# -----------------------------
cat >/opt/neko-rooms/bin/clone-gto-profiles.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

SOURCE_PROFILE="$${1:-/opt/neko-rooms/data/public/golden-firefox-profile}"
COUNT="$${2:-5}"
DEST_ROOT="/opt/neko-rooms/data/public/profile-clones"

mkdir -p "$DEST_ROOT"

if [ ! -d "$SOURCE_PROFILE" ]; then
  echo "Source profile does not exist yet: $SOURCE_PROFILE"
  echo "Skipping clone creation."
  exit 0
fi

for i in $(seq 1 "$COUNT"); do
  DEST="$DEST_ROOT/gto-profile-$i"

  if [ -d "$DEST" ]; then
    echo "Profile clone already exists: $DEST"
    rm -f "$DEST/lock" "$DEST/.parentlock" "$DEST/parent.lock" || true
    continue
  fi

  echo "Creating profile clone: $DEST"
  cp -a "$SOURCE_PROFILE" "$DEST"

  rm -f "$DEST/lock" "$DEST/.parentlock" "$DEST/parent.lock" || true
done

chown -R 1000:1000 "$DEST_ROOT" || true
EOF

chmod +x /opt/neko-rooms/bin/clone-gto-profiles.sh

# -----------------------------
# Idle cleanup script
# -----------------------------
cat >/opt/neko-rooms/bin/cleanup-idle-rooms.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

IDLE_LIMIT_MS=$((3 * 60 * 1000))
NO_ROOMS_LIMIT_SECONDS=60
STATE_DIR="/var/lib/neko-rooms"
NO_ROOMS_SINCE_FILE="$STATE_DIR/no-rooms-since"

mkdir -p "$STATE_DIR"

echo "[$(date -Is)] Checking Neko room idle times..."

get_room_containers() {
  docker ps \
    --format "{{.Names}}" \
    | grep -E "^neko-rooms-poker-room|^poker-room" || true
}

containers="$(get_room_containers)"

if [ -z "$containers" ]; then
  echo "[$(date -Is)] No active poker room containers found."
else
  for container in $containers; do
    echo "[$(date -Is)] Checking $container..."

    idle_ms=$(docker exec "$container" bash -lc 'DISPLAY="$${DISPLAY:-:99.0}" xprintidle' 2>/dev/null || echo "")

    if ! [[ "$idle_ms" =~ ^[0-9]+$ ]]; then
      echo "[$(date -Is)] Could not read idle time for $container. Skipping."
      continue
    fi

    echo "[$(date -Is)] $container idle for $${idle_ms}ms"

    if [ "$idle_ms" -gt "$IDLE_LIMIT_MS" ]; then
      echo "[$(date -Is)] Removing idle room container: $container"
      docker rm -f "$container"
    fi
  done
fi

remaining_containers="$(get_room_containers)"
now="$(date +%s)"

if [ -n "$remaining_containers" ]; then
  echo "[$(date -Is)] Active room containers still exist. Resetting no-room timer."
  rm -f "$NO_ROOMS_SINCE_FILE"
  exit 0
fi

if [ ! -f "$NO_ROOMS_SINCE_FILE" ]; then
  echo "$now" > "$NO_ROOMS_SINCE_FILE"
  echo "[$(date -Is)] No rooms found. Starting no-room timer."
  exit 0
fi

no_rooms_since="$(cat "$NO_ROOMS_SINCE_FILE" 2>/dev/null || echo "$now")"

if ! [[ "$no_rooms_since" =~ ^[0-9]+$ ]]; then
  echo "$now" > "$NO_ROOMS_SINCE_FILE"
  echo "[$(date -Is)] Invalid no-room timer. Resetting timer."
  exit 0
fi

elapsed=$((now - no_rooms_since))

echo "[$(date -Is)] No rooms for $${elapsed}s."

if [ "$elapsed" -ge "$NO_ROOMS_LIMIT_SECONDS" ]; then
  echo "[$(date -Is)] No rooms for at least $${NO_ROOMS_LIMIT_SECONDS}s. Shutting down EC2 instance."

  rm -f "$NO_ROOMS_SINCE_FILE"

  /sbin/shutdown -h now "No active Neko rooms for $${NO_ROOMS_LIMIT_SECONDS} seconds"
fi
EOF

chmod +x /opt/neko-rooms/bin/cleanup-idle-rooms.sh

# -----------------------------
# Cron every 20 seconds
# -----------------------------
cat >/etc/cron.d/neko-idle-cleanup <<'EOF'
* * * * * root flock -n /tmp/neko-idle-cleanup.lock /opt/neko-rooms/bin/cleanup-idle-rooms.sh >> /var/log/neko-idle-cleanup.log 2>&1
* * * * * root sleep 20; flock -n /tmp/neko-idle-cleanup.lock /opt/neko-rooms/bin/cleanup-idle-rooms.sh >> /var/log/neko-idle-cleanup.log 2>&1
* * * * * root sleep 40; flock -n /tmp/neko-idle-cleanup.lock /opt/neko-rooms/bin/cleanup-idle-rooms.sh >> /var/log/neko-idle-cleanup.log 2>&1
EOF

chmod 0644 /etc/cron.d/neko-idle-cleanup
systemctl enable cron
systemctl restart cron

# -----------------------------
# Ensure Firefox golden profile and clones exist
# -----------------------------
mkdir -p /opt/neko-rooms/data/public/profile-clones

if [ ! -d /opt/neko-rooms/data/public/golden-firefox-profile ]; then
  if [ -d /opt/neko-rooms/data/public/firefox-profile ]; then
    echo "golden-firefox-profile missing. Creating it from firefox-profile."
    cp -a /opt/neko-rooms/data/public/firefox-profile /opt/neko-rooms/data/public/golden-firefox-profile
  elif [ -d /opt/neko-rooms/data/public/profile-clones/gto-profile-1 ]; then
    echo "golden-firefox-profile missing. Creating it from existing gto-profile-1."
    cp -a /opt/neko-rooms/data/public/profile-clones/gto-profile-1 /opt/neko-rooms/data/public/golden-firefox-profile
  else
    echo "No existing profile found. Creating empty golden-firefox-profile."
    mkdir -p /opt/neko-rooms/data/public/golden-firefox-profile
  fi
fi

rm -f /opt/neko-rooms/data/public/golden-firefox-profile/lock \
      /opt/neko-rooms/data/public/golden-firefox-profile/.parentlock \
      /opt/neko-rooms/data/public/golden-firefox-profile/parent.lock || true

chown -R 1000:1000 /opt/neko-rooms/data/public/golden-firefox-profile || true

for i in 1 2 3 4 5; do
  DEST="/opt/neko-rooms/data/public/profile-clones/gto-profile-$i"

  if [ ! -d "$DEST" ]; then
    echo "Creating missing clone: $DEST"
    cp -a /opt/neko-rooms/data/public/golden-firefox-profile "$DEST"
  fi

  rm -f "$DEST/lock" "$DEST/.parentlock" "$DEST/parent.lock" || true
done

chown -R 1000:1000 /opt/neko-rooms/data/public/profile-clones || true

# -----------------------------
# Pull images and start Neko Rooms
# -----------------------------
docker pull m1k1o/neko-rooms:latest || true
docker pull ghcr.io/m1k1o/neko/firefox:latest || true
docker pull sebat2004/neko-firefox-xprintidle:latest || true

cd /opt/neko-rooms
docker compose up -d --force-recreate

# -----------------------------
# Final status/debug output
# -----------------------------
docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}'

docker inspect neko-rooms-neko-rooms-1 \
  --format '{{range .Config.Env}}{{println .}}{{end}}' \
  | sort \
  | grep -E 'NEKO_ROOMS_INSTANCE_URL|NEKO_ROOMS_NAT1TO1|NEKO_ROOMS_INSTANCE_NETWORK|NEKO_ROOMS_NEKO_IMAGES' || true

echo "Checking profile directories..."
ls -la /opt/neko-rooms/data/public || true
ls -la /opt/neko-rooms/data/public/profile-clones || true

systemctl status caddy --no-pager || true
systemctl status cron --no-pager || true